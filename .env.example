# Environment variables for third-party APIs (Firebase AI Logic uses App Check and requires no GEMINI_API_KEY)
# GST backend configuration belongs to Cloud Functions, never the browser frontend.
# Set credentials with `firebase functions:secrets:set`; do not commit real values.

GSP_BASE_URL=https://your-real-gsp-host
GSP_IP_USER=YOUR_PROVIDER_APPROVED_STATIC_EGRESS_IP
GST_ALLOWED_ORIGINS=https://your-finboss-host.web.app,https://your-finboss-host.firebaseapp.com,http://localhost:8080
