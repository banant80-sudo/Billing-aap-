# Environment variables for third-party APIs (Firebase AI Logic uses App Check and requires no GEMINI_API_KEY)
# GST backend environment only. Use Firebase Secret Manager for credentials.

GSP_BASE_URL=https://apisandbox.whitebooks.in
GSP_IP_ADDRESS=YOUR_PROVIDER_APPROVED_SERVER_IP
GSTR3B_EVC_FILE_PATH=/gstr3b/retevcfile
GST_ALLOWED_ORIGINS=https://your-finboss-host.web.app,https://your-finboss-host.firebaseapp.com,http://localhost:8080
