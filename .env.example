# Environment variables for the secure GST backend
# Keep real secrets in your deployment environment, never in frontend code.

PORT=4000
GSP_PROVIDER=mastergst
GSP_BASE_URL=https://example-gsp.com
GSP_CLIENT_ID=YOUR_GSP_CLIENT_ID
GSP_CLIENT_SECRET=YOUR_GSP_CLIENT_SECRET
GSP_ALLOWED_ORIGIN=http://localhost:3000
