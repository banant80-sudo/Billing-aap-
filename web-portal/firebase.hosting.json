{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.hosting.json",
      "README.md",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "gstApi",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
